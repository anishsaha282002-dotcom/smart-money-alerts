# Copy to .env and fill in only what you need. All keys are optional.
# Never put a wallet private key or seed phrase in this file — this project has no use for one.
# Do not commit .env.

# Helius free plan (https://dashboard.helius.dev) — Parsed Streams worker + Parsed Events fallback
HELIUS_API_KEY=

# X (Twitter) API v2 bearer token — optional caller-chatter grading
X_BEARER_TOKEN=

# GMGN Agent API key (https://gmgn.ai/ai) — optional; smart-money/KOL feeds stay dormant without it
# Do NOT set a GMGN private key; it is never read.
GMGN_API_KEY=
