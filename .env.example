# Copy to .env and fill in what you have. EVERY line is optional: with none of them the tool
# still runs on the keyless sources (and `sms demo` needs nothing at all).
#
# Public API keys and bot tokens only. This project never needs, and must never be given,
# a wallet private key or seed phrase.

# Solana wallet history — free at https://dashboard.helius.dev
HELIUS_API_KEY=

# Smart-money + KOL feeds, wallet history and call-outs on Solana / BSC / Base (used READ-ONLY)
# — free at https://gmgn.ai/ai . Their form asks for an Ed25519 PUBLIC key; see the README for the
# two commands. Only the API key goes here. The private half of that pair is never needed by this
# tool: do not put it in this file.
GMGN_API_KEY=

# X/Twitter caller chatter — needs a paid X API tier; leave empty to use GMGN call-outs instead
X_BEARER_TOKEN=

# Telegram delivery — token from @BotFather, chat id from @userinfobot or your channel
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord delivery — Channel settings → Integrations → Webhooks → New Webhook → Copy URL
DISCORD_WEBHOOK_URL=

# Optional LLM rewording of the alert text (also set llm_reword = true in config.toml,
# and `pip install "smart-money-stories[llm]"`)
ANTHROPIC_API_KEY=
